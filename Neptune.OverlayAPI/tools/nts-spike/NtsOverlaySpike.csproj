<Project Sdk="Microsoft.NET.Sdk">
  <!-- NPT-1105 Part 2: throwaway benchmark spike — NOT part of Neptune.sln.
       Reproduces the TGU overlay pipeline (clean → flatten → union) in NetTopologySuite
       against the captured golden inputs, to answer the go/no-go on the QGIS -> NTS port.
       Run: dotnet run -c Release -\- <inputFolder> <prefix> <outputPath> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.Features" Version="2.2.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
  </ItemGroup>
</Project>
