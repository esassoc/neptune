{
  // Opts local runs into the dev Key Vault (Build/dev-tf) so real secrets need not be
  // pasted into local files. It does not remove the other local sources -- an appsecrets
  // file loaded via SECRET_PATH still layers underneath, and an environment variable
  // still overrides -- it just means the vault supplies the values by default.
  //
  // Development-only by construction: deployed pods run Staging or Production and take
  // KeyVaultName from their Helm ConfigMap (global.env.keyVaultName), so this can never
  // reach QA or prod.
  //
  // Set here rather than as a machine-level env var on purpose: every app in this
  // family reads the same "KeyVaultName" key, so a user-scoped environment variable
  // would silently point every other app's local run at Neptune's vault.
  //
  // FAILS FAST: with this set, startup errors if the vault does not exist or the
  // caller cannot read it. Authentication is DefaultAzureCredential, so an `az login`
  // (tenant-scoped), Visual Studio's Azure Service Authentication account, or the
  // usual environment variables all work -- but you need one of them, plus membership
  // in the AAD group holding "Key Vault Secrets User". To opt out for a single run,
  // override with an empty KeyVaultName environment variable, which outranks this file.
  "KeyVaultName": "neptune-keyvault-dev"
}
